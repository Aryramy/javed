# ==============================================================================
# Javed (JARVIS) — Git Ignore Policy
# ==============================================================================

# Environment and Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example

# Python Runtimes, Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node.js, Frontend Bundles & Package Caches
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases, Checkpoints & SQLite Stores
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
*.db

# Browser Automation Artifacts & Test Results
test-results/
playwright-report/
blob-report/
playwright/.cache/
scratch/downloads/

# Operating System & Editor Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
scratch/
